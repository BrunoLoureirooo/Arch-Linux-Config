#!/usr/bin/env python3
"""Shake the pointer to enlarge it, like macOS "shake mouse pointer to locate".

Hyprland 0.56 has no such option, so this watches the pointer from outside. Idle cost is zero:
the process sleeps in select() on the mouse and touchpad event nodes (readable through the
seat ACL, no input group needed) and only while the pointer moves does it read the position
from Hyprland's socket, about 60 times a second. A quick back-and-forth swing grows the
cursor with `setcursor`; it shrinks again once the shaking stops.
"""
import json
import os
import re
import select
import socket
import sys
import time

THEME = "default"  # Hyprland runs the xcursor default theme (no XCURSOR_* set)
NORMAL = 24
BIG = 96
POLL = 1 / 60
WINDOW = 0.6  # seconds of movement the detector looks at
MIN_STEP = 6  # px: smaller moves are jitter, not a direction
MIN_SWING = 50  # px: a swing shorter than this is not a shake
REVERSALS = 4  # direction changes inside WINDOW
HOLD = 0.8  # seconds without shaking before shrinking back
DEBUG = os.environ.get("CURSOR_SHAKE_DEBUG")  # file to log swing counts to, for tuning


def is_shake(samples):
    """samples: [(t, x, y)] inside WINDOW. True for a rapid back-and-forth swing on x or y."""
    return swings(samples) >= REVERSALS


def swings(samples):
    """Most direction changes (each after a swing of MIN_SWING px or more) on either axis."""
    best = 0
    for axis in (1, 2):
        dirs = []  # +1/-1 per swing, with the travelled distance of that swing
        last = samples[0][axis] if samples else 0
        run = 0
        sign = 0
        for s in samples[1:]:
            d = s[axis] - last
            if abs(d) < MIN_STEP:
                continue
            last = s[axis]
            if sign and (d > 0) != (sign > 0):
                dirs.append(run)
                run = 0
            sign = 1 if d > 0 else -1
            run += abs(d)
        best = max(best, sum(1 for r in dirs if r >= MIN_SWING))
    return best


def pointer_nodes(devices_text, exclude=("xremap",)):
    """/proc/bus/input/devices text -> sorted /dev/input/eventN of every mouse and touchpad."""
    nodes = []
    for block in devices_text.split("\n\n"):
        name = re.search(r'^N: Name="(.*)"', block, re.M)
        handlers = re.search(r"^H: Handlers=(.*)", block, re.M)
        if not name or not handlers or any(x in name.group(1) for x in exclude):
            continue
        h = handlers.group(1).split()
        ev = [x for x in h if re.fullmatch(r"event\d+", x)]
        if ev and any(re.fullmatch(r"mouse\d+", x) for x in h):
            nodes.append("/dev/input/" + ev[0])
    return sorted(nodes)


def hypr(cmd):
    sock = "%s/hypr/%s/.socket.sock" % (os.environ["XDG_RUNTIME_DIR"], os.environ["HYPRLAND_INSTANCE_SIGNATURE"])
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(1)
        s.connect(sock)
        s.sendall(cmd.encode())
        out = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                return out.decode()
            out += chunk


def set_size(size):
    reply = hypr("/setcursor %s %d" % (THEME, size))
    if DEBUG:
        with open(DEBUG, "a") as f:
            f.write("%.2f setcursor %d -> %r\n" % (time.monotonic(), size, reply))
    return reply == "ok"


def open_new(fds):
    try:
        text = open("/proc/bus/input/devices").read()
    except OSError:
        return
    for path in pointer_nodes(text):
        if path not in fds.values():
            try:
                fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
            except OSError:
                pass


def drain(fds):
    for fd in list(fds):
        try:
            while os.read(fd, 4096):
                pass
        except BlockingIOError:
            pass
        except OSError:  # device unplugged
            os.close(fd)
            del fds[fd]


def main():
    fds = {}
    big = False
    samples = []
    shaken_at = 0.0
    last_move = 0.0
    last_pos = None
    last_poll = 0.0
    try:
        while True:
            open_new(fds)
            moving = bool(samples) or big
            ready, _, _ = select.select(list(fds), [], [], POLL if moving else 30)
            if ready:
                drain(fds)
                # Events arrive in bursts; cap the position reads at ~60 a second.
                time.sleep(max(0, POLL - (time.monotonic() - last_poll)))
            last_poll = time.monotonic()
            now = last_poll
            if not ready and not moving:
                continue  # 30 s timeout: only to notice a hot-plugged mouse
            try:
                pos = json.loads(hypr("j/cursorpos"))
                pos = (pos["x"], pos["y"])
            except (OSError, ValueError, KeyError):
                return 1  # compositor gone
            if pos != last_pos:
                last_pos = pos
                last_move = now
                samples.append((now, pos[0], pos[1]))
            samples = [s for s in samples if now - s[0] <= WINDOW]
            if DEBUG and len(samples) > 3:
                n = swings(samples)
                if n:
                    with open(DEBUG, "a") as f:
                        f.write("%.2f n=%d samples=%d span=%.0fx%.0f\n" % (now, n, len(samples),
                                max(s[1] for s in samples) - min(s[1] for s in samples),
                                max(s[2] for s in samples) - min(s[2] for s in samples)))
            if len(samples) > 3 and is_shake(samples):
                shaken_at = now
                if not big and set_size(BIG):
                    big = True
            if big and now - shaken_at > HOLD:
                set_size(NORMAL)
                big = False
            if not big and now - last_move > WINDOW:
                samples = []
    finally:
        try:
            set_size(NORMAL)
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main())
